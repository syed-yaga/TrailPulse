{
  "name": "trailpulse",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TrailPulse - Offline-First Nature Audio Guide (Strict TypeScript)",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "build": "npm run build --workspace=client && npm run build --workspace=server",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "start": "node server/dist/server.js",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "ollama": "ollama serve"
  },
  "keywords": [
    "hacktoberfest",
    "touch-grass",
    "offline-pwa",
    "typescript",
    "gemma2",
    "elevenlabs",
    "audio-guide"
  ],
  "author": "",
  "license": "MIT"
}
